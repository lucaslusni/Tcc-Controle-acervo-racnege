# URL do PostgreSQL usado pelo Prisma
DATABASE_URL="postgresql://usuario:senha@localhost:5432/acervo?schema=public"

# Segredos locais: gere valores próprios com pelo menos 32 caracteres
FJWT_SECRET=
COOKIES_SECRET=

# Mailgun (opcional para os fluxos de e-mail)
EMAIL_API_KEY=
EMAIL_DOMAIN=

PORT=8080
HOST=0.0.0.0
